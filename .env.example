PORT=10000
NODE_ENV=production
SESSION_SECRET=change-me-to-a-long-random-string
# Permanent public URL after deploy (no trailing slash)
PUBLIC_URL=https://sd33-field-hub.onrender.com

# Private development mode (default ON). Site shows development notice and
# does not accept volunteer / contribution / campaign form submissions.
# Set to false only when ready for public campaign operations (with counsel).
PRIVATE_DEVELOPMENT=true

# Captain notify — recommended: Zapier/Make webhook that emails+SMS you
NOTIFY_WEBHOOK=https://hooks.zapier.com/hooks/catch/xxx/yyy
ADMIN_NOTIFY_EMAIL=you@example.com
ADMIN_NOTIFY_PHONE=+16515550100

# Optional Twilio auto-text to volunteer + admin
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1...
